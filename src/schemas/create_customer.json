{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "document": { 
      "type": "string",
      "pattern": "^\\d{11}$" 
    },
    "university_id": { "type": "integer", "minimum": 1 },
    "course_id": { "type": "integer", "minimum": 1 }
  },
  "required": ["document", "university_id", "course_id"],
  "additionalProperties": false
}