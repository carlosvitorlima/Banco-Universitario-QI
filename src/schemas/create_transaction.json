{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "idempotency_key": {
      "type": "string",
      "minLength": 5
    },
    "origin_account_key": {
      "type": "string",
      "format": "uuid"
    },
    "destination_account_key": {
      "type": "string",
      "format": "uuid"
    },
    "amount": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "idempotency_key",
    "origin_account_key",
    "destination_account_key",
    "amount"
  ],
  "additionalProperties": false
}