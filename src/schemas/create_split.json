{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "splits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "account_key": { "type": "string", "format": "uuid" },
          "amount": { "type": "integer", "minimum": 1 }
        },
        "required": ["account_key", "amount"],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": ["splits"],
  "additionalProperties": false
}